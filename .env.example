# --- Non-secret config (safe to keep as plain values) ---
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8787
# Public HTTPS URL registered with X (NO PORT). Tunnel via ngrok/cloudflare in local dev.
PUBLIC_WEBHOOK_URL=

ALERT_LOG_PATH=logs/alerts.jsonl
ALERT_MEMORY_LIMIT=200
SKIP_SIGNATURE_VERIFY=false
ALLOW_INFERENCE_HOOKS=false
PR_RESOLVE_TIMEOUT=8
PR_RESOLVE_MAX_REDIRECTS=8

GOOGLE_SHEET_ID=1Xa4HDvSMC5HxG7G92tOQOIeDlF2AP-F32hwbwvrHPlw
SHEET_TAB=2026
SHEET_TICKER_COLUMN=Ticker
GOOGLE_SERVICE_ACCOUNT_JSON=
TICKER_CACHE_PATH=config/tickers.json
SOURCE_ACCOUNTS_PATH=config/source_accounts.json
SHEET_REFRESH_TIMES=08:12,16:12

# --- Secrets via 1Password CLI (NO plaintext keys on disk) ---
# Create one Login/API Credential item in 1Password, then paste its item UUID below.
# Reference format: op://<Vault>/<Item-Name-or-UUID>/<field>
# Fields suggested on the item:
#   username     → API Key (consumer key)     OR use a custom field "api_key"
#   credential   → API Secret (consumer secret)
#   bearer       → Bearer Token (custom field; create if missing)
#
# Example (replace Vault name and ITEM_UUID):
OP_X_API_ITEM_ID=ITEM_UUID_HERE
X_API_KEY=op://Private/ITEM_UUID_HERE/username
X_API_SECRET=op://Private/ITEM_UUID_HERE/credential
X_BEARER_TOKEN=op://Private/ITEM_UUID_HERE/bearer

# Optional user OAuth (also prefer op://)
# X_ACCESS_TOKEN=op://Private/ITEM_UUID_HERE/access_token
# X_ACCESS_TOKEN_SECRET=op://Private/ITEM_UUID_HERE/access_token_secret

# Requires: 1Password CLI on PATH + `op signin` (or unlocked desktop app).
# Verify: python scripts/verify_op_secrets.py
